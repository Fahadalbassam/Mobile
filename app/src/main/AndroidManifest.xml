<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed to show reminder notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Needed to fire reminders at the exact time.
         Android 12: SCHEDULE_EXACT_ALARM. Android 13+: USE_EXACT_ALARM, which is granted
         automatically to reminder / calendar apps like this one. -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Needed to restore reminders after the phone restarts -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.StudentPlanner">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".TaskListActivity"
            android:label="@string/title_tasks"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".TaskEditActivity"
            android:label="@string/title_task"
            android:parentActivityName=".TaskListActivity" />

        <activity
            android:name=".ScheduleActivity"
            android:label="@string/title_schedule"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ClassEditActivity"
            android:label="@string/title_class"
            android:parentActivityName=".ScheduleActivity" />

        <!-- Receives alarms from AlarmManager and shows the notification -->
        <receiver
            android:name=".ReminderReceiver"
            android:exported="false" />

        <!-- Home-screen widget (a small Today dashboard) -->
        <receiver
            android:name=".TodayWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>

        <!-- Handles the "Done" and "Snooze" buttons on reminder notifications -->
        <receiver
            android:name=".NotificationActionReceiver"
            android:exported="false" />

        <!-- Restores all reminders after the device reboots -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Background service that re-schedules every reminder from the database -->
        <service
            android:name=".ReminderService"
            android:exported="false" />

    </application>
</manifest>
